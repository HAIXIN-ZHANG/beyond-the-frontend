{
  "name": "vibe-coding-then-what",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev site",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build site",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/vibe-coding-then-what npm run build",
    "lint": "eslint site scripts tests eslint.config.mjs --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "verify:export": "node scripts/verify-export.mjs",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen site && tsc --project site/tsconfig.json --noEmit"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
